#!/bin/sh /etc/rc.common
# Klingel-Dashboard Brume 2 – Autostart (procd)
# start/stop/restart:  /etc/init.d/klingel-dashboard start|stop|restart
# Log ansehen:         tail -f /root/Klingel-Dashboard/logs/klingel.log  (oder logread -e klingel)

START=99
STOP=10
USE_PROCD=1

APP_DIR=/root/Klingel-Dashboard

start_service() {
	procd_open_instance klingel
	procd_set_param command /usr/bin/python3 -u "$APP_DIR/klingel_server.py"
	procd_set_param env PYTHONUNBUFFERED=1 PATH=/usr/sbin:/usr/bin:/sbin:/bin
	# bei Absturz automatisch neu starten (unbegrenzt, 5 s Pause)
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 8
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "klingel-dashboard"
}
